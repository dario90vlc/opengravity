{
  "name": "opengravity",
  "productName": "Opengravity",
  "version": "0.3.0",
  "private": true,
  "description": "IDE con agentes multi-proveedor — app de escritorio open source",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run build && node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "app": "npm run build && npm run build:monaco && electron .",
    "app:only": "electron .",
    "build:monaco": "node scripts/build-monaco.mjs",
    "dist": "npm run build && npm run build:monaco && electron-builder --win nsis portable --publish never",
    "dist:dir": "npm run build && npm run build:monaco && electron-builder --win --dir --publish never",
    "verify:release": "node scripts/verificar-entrega.mjs",
    "verify:selector": "node scripts/verificar-selector.mjs",
    "verify:installer": "node scripts/verificar-instalador.mjs",
    "test": "node --test test/*.test.mjs",
    "pretest": "npm run build",
    "test:watch": "node --test --watch test/*.test.mjs"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.18",
    "ajv": "^8.20.0",
    "electron-updater": "^6.8.11",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^33.2.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.2",
    "katex": "^0.16.11",
    "monaco-editor": "^0.57.0",
    "typescript": "^5.7.0",
    "typescript-language-server": "^6.0.3"
  },
  "build": {
    "appId": "app.opengravity",
    "productName": "Opengravity",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "electron/sandbox-run.cs",
      "electron/sandbox-win.ps1",
      "electron/decrypt-keys.cjs"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Opengravity",
      "artifactName": "Opengravity-Setup-${version}.${ext}",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico"
    },
    "portable": {
      "artifactName": "Opengravity-${version}.${ext}"
    },
    "linux": {
      "icon": "assets/icon-512.png",
      "category": "Development"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "dario90vlc",
        "repo": "opengravity",
        "releaseType": "release"
      }
    ]
  }
}
